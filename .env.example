# Private keys and API keys (DO NOT COMMIT TO VERSION CONTROL)
PRIVATE_KEY=your_wallet_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
INFURA_KEY=your_infura_project_id_here

# RPC URLs
MAINNET_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_SEPOLIA_URL=https://arbitrum-sepolia.infura.io/v3/YOUR_INFURA_KEY

# Deployment configuration
FEE_COLLECTOR=0x_your_fee_collector_address_here
CREATE_SAMPLE_BILL=false

# Gas settings
GAS_PRICE=20
GAS_LIMIT=3000000

# Frontend environment variables
REACT_APP_CONTRACT_ADDRESS=0x_deployed_contract_address_here
REACT_APP_NETWORK_ID=1
REACT_APP_INFURA_KEY=your_infura_project_id_here
REACT_APP_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here

# PYUSD Contract Addresses (for reference)
# Ethereum Mainnet: 0x6c3ea9036406852006290770bedfcaba0e23a0e8
# Arbitrum: 0x46850ad61c2b7d64d08c9c754f45254596696984
# Ethereum Sepolia: 0x7c8ca1a587b2c4c40fc650db8196ee66dc9c46f4 (testnet)

# Optional: Analytics and monitoring
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=your_ga_id_here

# Optional: Database (if adding backend)
DATABASE_URL=postgresql://user:password@localhost:5432/splitbill
REDIS_URL=redis://localhost:6379

# Optional: Email service (for notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com
